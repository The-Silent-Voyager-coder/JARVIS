# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Secrets are injected as environment variables — they are NEVER stored in
# config files or source code. See docs/CONFIGURATION.md.

# Optional: API keys for future external providers (all optional, zero-cost core)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# Optional: OpenCode server endpoint overrides (defaults in jarvis.example.yaml)
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_API_KEY=
