# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets (never committed) ---
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# --- J.A.R.V.I.S. runtime ---
data/
cache/
logs/
runtime/
backups/
models/
!models/.gitkeep

# --- Databases (never public) ---
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# --- Crypto material ---
*.p12
*.pfx

# --- Local configuration (real config, not example) ---
config/jarvis.yaml
config/*.local.yaml

# --- Local workspaces (may contain large projects) ---
workspaces/
!workspaces/.gitkeep

# --- Legacy reference projects (previous Jarvis models, local only) ---
legacy/

# --- Coverage / logs ---
.coverage.*
coverage.xml
*.log

# --- Editors / OS ---
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
